@model IEnumerable<appSatTech.Models.Chamado>

@{
    ViewData["Title"] = "Central de Chamados";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold text-dark mb-1"><i class="bi bi-headset me-2 text-primary"></i>Central de Chamados</h2>
        <p class="text-muted small mb-0">Gerencie e acompanhe o andamento das solicitações</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-3 shadow-sm px-4">
        <i class="bi bi-plus-lg me-1"></i> Novo Chamado
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light border-bottom">
                <tr>
                    <th class="py-3 px-4 text-secondary small text-uppercase fw-bold">Data/Hora</th>
                    <th class="py-3 text-secondary small text-uppercase fw-bold">Status</th>
                    <th class="py-3 text-secondary small text-uppercase fw-bold">Cliente</th>
                    <th class="py-3 text-secondary small text-uppercase fw-bold">Técnico</th>
                    <th class="py-3 text-end px-4 text-secondary small text-uppercase fw-bold">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="px-4 fw-semibold text-dark">
                            <i class="bi bi-calendar3 me-2 text-muted"></i>
                            @item.DataHora.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td>
                            @if (item.StatusAtendimento == "Agendada")
                            {
                                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-semibold">
                                    <i class="bi bi-clock-history me-1"></i> Agendada
                                </span>
                            }
                            else if (item.StatusAtendimento == "Realizada")
                            {
                                <span class="badge bg-success text-white px-3 py-2 rounded-pill fw-semibold">
                                    <i class="bi bi-check-circle me-1"></i> Realizada
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger text-white px-3 py-2 rounded-pill fw-semibold">
                                    <i class="bi bi-x-circle me-1"></i> Cancelada
                                </span>
                            }
                        </td>
                        <td>
                            <span class="fw-medium">@(item.Cliente?.Nome ?? $"ID: {item.ClienteId}")</span>
                        </td>
                        <td>
                            <span class="fw-medium">@(item.Tecnico?.Nome ?? $"ID: {item.TecnicoId}")</span>
                        </td>
                        <td class="text-end px-4">
                            <div class="btn-group btn-group-sm rounded-3 shadow-sm">
                                <a asp-action="Edit" asp-route-id="@item.Codigo" class="btn btn-outline-secondary" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Codigo" class="btn btn-outline-info" title="Detalhes">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Codigo" class="btn btn-outline-danger" title="Excluir">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
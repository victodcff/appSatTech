@model appSatTech.Models.Chamado

@{
    ViewData["Title"] = "Detalhes do Chamado";
}

<div class="row justify-content-center my-4">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-info-circle me-2 text-info"></i>Chamado #@Model.Codigo</h4>
                <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill">
                    @Model.StatusAtendimento
                </span>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0 gy-3">
                    <dt class="col-sm-4 text-muted">Data & Hora</dt>
                    <dd class="col-sm-8 fw-semibold text-dark mb-0">
                        <i class="bi bi-calendar-event me-2 text-primary"></i>@Model.DataHora.ToString("dd/MM/yyyy HH:mm")
                    </dd>

                    <dt class="col-sm-4 text-muted">Cliente</dt>
                    <dd class="col-sm-8 fw-semibold text-dark mb-0">
                        <i class="bi bi-person me-2 text-primary"></i>@(Model.Cliente?.Nome ?? $"ID: {Model.ClienteId}")
                    </dd>

                    <dt class="col-sm-4 text-muted">Técnico Responsável</dt>
                    <dd class="col-sm-8 fw-semibold text-dark mb-0">
                        <i class="bi bi-person-badge me-2 text-primary"></i>@(Model.Tecnico?.Nome ?? $"ID: {Model.TecnicoId}")
                    </dd>
                </dl>
            </div>
            <div class="card-footer bg-light border-top p-3 d-flex justify-content-between align-items-center">
                <a asp-action="Index" class="btn btn-outline-secondary px-3">
                    <i class="bi bi-arrow-left me-1"></i> Voltar
                </a>
                <a asp-action="Edit" asp-route-id="@Model.Codigo" class="btn btn-warning text-dark px-4 shadow-sm">
                    <i class="bi bi-pencil me-1"></i> Editar
                </a>
            </div>
        </div>
    </div>
</div>